{
  "name": "live-atlas",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "serve": "vite",
    "dev": "vite",
    "preview": "vite preview --port 8082",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "clean": "rimraf dist java/target/resources",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run clean && npm run typecheck && vite build --out-dir dist",
    "build:plugin": "npm run build && npm run mvn",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "mvn": "node scripts/copy-plugin-resources.mjs && cd java && mvn package"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@kyvg/vue3-notification": "^3.4.2",
    "animejs": "^4.5.0",
    "leaflet": "^1.9.4",
    "modern-normalize": "^3.0.1",
    "vue": "^3.5.44",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/dynmap": "^3.1.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "rimraf": "^6.1.3",
    "sass-embedded": "^1.105.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
