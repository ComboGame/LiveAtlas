{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "vitest/globals",
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "vuex": [
        "./node_modules/vuex/types/index.d.ts"
      ]
    },
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "test/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
